{
  "name": "cozyobserve",
  "version": "1.0.0-beta.0",
  "description": "Tiny, fast, fine-grained reactive observers for TypeScript and React — auto-tracked computed values, effects without dependency arrays, deep stores, and async resources.",
  "author": "M. Ergin Turk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RecursiveVoid/CozyObserve.git"
  },
  "homepage": "https://github.com/RecursiveVoid/CozyObserve#readme",
  "bugs": {
    "url": "https://github.com/RecursiveVoid/CozyObserve/issues"
  },
  "keywords": [
    "observer",
    "observable",
    "signals",
    "reactive",
    "computed",
    "effect",
    "store",
    "state",
    "react",
    "hooks",
    "useSyncExternalStore",
    "typescript",
    "lightweight",
    "fast",
    "cozy",
    "cozyobserve"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "npm run build && node bench/index.js",
    "size": "npm run build && size-limit",
    "format": "prettier --write \"{src,test,bench}/**/*.{ts,tsx,js}\"",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "size-limit": [
    {
      "name": "core primitives (observable, computed, effect, batch)",
      "path": "dist/index.js",
      "import": "{ observable, computed, effect, batch }",
      "limit": "1.75 kB"
    },
    {
      "name": "core: everything (incl. store, resource, compat)",
      "path": "dist/index.js",
      "limit": "4.75 kB"
    },
    {
      "name": "react: useObserver + useObserverEffect + tracked (incl. core)",
      "path": "dist/react.js",
      "import": "{ useObserver, useObserverEffect, tracked }",
      "limit": "2.75 kB",
      "ignore": [
        "react"
      ]
    },
    {
      "name": "react: everything (incl. core)",
      "path": "dist/react.js",
      "limit": "5 kB",
      "ignore": [
        "react"
      ]
    }
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@preact/signals-core": "^1.14.4",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "alien-signals": "^3.2.1",
    "cozyobserve-legacy": "npm:cozyobserve@^0.2.2",
    "jsdom": "^29.1.1",
    "mitata": "^1.0.34",
    "mobx": "^7.1.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rxjs": "^7.8.2",
    "size-limit": "^14.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "valtio": "^2.3.2",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  }
}
